service : {
  _immutableObjectStorageBlobsAreLive: (hashes: vec blob) -> (vec bool) query;
  _immutableObjectStorageBlobsToDelete: () -> (vec blob) query;
  _immutableObjectStorageConfirmBlobDeletion: (blobs: vec blob) -> ();
  _immutableObjectStorageCreateCertificate: (blobHash: text) ->
   (_ImmutableObjectStorageCreateCertificateResult);
  _immutableObjectStorageRefillCashier: (refillInformation:
   opt _ImmutableObjectStorageRefillInformation) ->
   (_ImmutableObjectStorageRefillResult);
  _immutableObjectStorageUpdateGatewayPrincipals: () -> ();
  addSuperAdmin: (newAdmin: principal) -> (Result_1);
  addSupportMessage: (conversationId: SupportConversationId, message:
   text) -> (Result_27);
  addZahlung: (rechnungId: text, datum: text, betrag: nat) -> (Result_26);
  archivierMandat: (id: text) -> (Result_1);
  changeEmail: (pendingId: PendingRegistrationId, newEmail: text) -> (Result);
  completeRegistration: (pendingId: PendingRegistrationId) -> (Result_25);
  createAuslage: (mandatId: text, beschreibung: text, kategorie:
   AuslagenKategorie, betrag: nat, datum: text) -> (Result_12);
  createDsrRequest: (req: DsrRequest) -> (DsrRequest);
  createInviteLink: (email: text) -> (Result_17);
  createKlient: (name: text, strasse: text, plzOrt: text, telefon: text,
   email: text) -> (Result_7);
  createLeistung: (mandatId: text, taetigkeit: text, datum: text, dauer:
   nat) -> (Result_6);
  createMandat: (klientId: text, bezeichnung: text, akquisiteurId: principal,
   akquisitionsbonus: nat, mwstSatz: nat, budget: nat, rundungAktiv: 
   bool, auslagenregelung: Auslagenregelung, pauschalBetrag: nat,
   zahlungsbedingungen: text, waehrung: text, standardStundensatz: nat,
   kostenProKopie: float64, kostenProScan: float64, portoAPost: float64,
   portoBPost: float64, portoEinschreiben: float64, autokilometer: float64,
   leistungenAusweisen: bool) -> (Result_5);
  createRechnung: (mandatId: text, leistungsIds: vec text, auslageIds:
   vec text, rechnungsdatum: text, zahlungsbedingungen: text,
   leistungszeitraumVon: text, leistungszeitraumBis: text) -> (Result_24);
  createSupportConversation: (category: SupportCategory, subject: text,
   message: text, appRoute: text, appVersion: text) -> (Result_3);
  deactivateKanzlei: (kanzleiId: text) -> (Result_1);
  deleteAuslage: (id: text) -> (Result_1);
  deleteKanzlei: (kanzleiId: text) -> (Result_1);
  deleteKlient: (id: text) -> (Result_1);
  deleteLeistung: (id: text) -> (Result_1);
  deleteLeistungserbringer: (userId: text) -> (Result_1);
  deleteMandat: (id: text) -> (Result_1);
  execute: (qJson: text) -> (Result__1) query;
  executeDeletion: (categoryName: text, entityId: text) -> (Result_1);
  exportAuditTrailCsv: (filter: AuditTrailFilter) -> (text) query;
  exportAuditTrailPdf: (filter: AuditTrailFilter) -> (blob) query;
  exportKanzleienCsv: () -> (text) query;
  exportKanzleienPdf: () -> (blob) query;
  getActiveUsersPerMonth: (kanzleiId: KanzleiId, year: nat) ->
   (ActiveUsersYearReport) query;
  getAllActiveUsersPerMonth: (year: nat) ->
   (vec AllKanzleienActiveUsersReport) query;
  getAllKanzleienOverview: () -> (vec KanzleiOverview) query;
  getAllSupportConversations: () -> (Result_23);
  getAuditTrail: (filter: AuditTrailFilter) -> (vec AuditLogEntry) query;
  getAuslagen: (filter: AuslagenFilter) -> (vec Auslage) query;
  getBudgetSummaries: () -> (vec BudgetSummary) query;
  getBudgetSummary: (mandatId: MandatId) -> (Result_22) query;
  getConsentRecords: (kanzleiId: KanzleiId) -> (vec ConsentRecord) query;
  getCurrentUser: () -> (opt Leistungserbringer) query;
  getDashboardStats: (kanzleiId: KanzleiId) -> (DashboardStats) query;
  getDataFlows: (kanzleiId: KanzleiId) -> (vec DataFlowEntry) query;
  getDataInventory: (kanzleiId: KanzleiId) -> (vec DataInventoryEntry) query;
  getDsgVersion: () -> (opt DsgVersion) query;
  getDsrRequests: (kanzleiId: KanzleiId) -> (vec DsrRequest) query;
  getGehaltReport: (year: nat, month: opt nat) -> (vec GehaltInfo) query;
  getInviteLinks: () -> (vec InviteToken) query;
  getKanzlei: () -> (opt Kanzlei) query;
  getKanzleiReport: (year: nat, period: ReportPeriod) -> (FirmReport) query;
  getKanzleiStammdaten: () -> (opt KanzleiStammdaten) query;
  getKlient: (id: text) -> (opt Klient) query;
  getKlienten: () -> (vec Klient) query;
  getLeistungen: (filter: LeistungFilter) -> (vec Leistung) query;
  getLeistungserbringer: () -> (vec Leistungserbringer) query;
  getLeistungserbringerByKanzlei: (kanzleiId: KanzleiId) ->
   (vec Leistungserbringer) query;
  getLeistungserbringerReport: (providerId: opt principal, year: nat, period:
   ReportPeriod) -> (ProviderReport) query;
  getLogo: () -> (opt ExternalBlob) query;
  getMandat: (id: text) -> (opt Mandat) query;
  getMandate: (klientId: opt text) -> (vec Mandat) query;
  getMyRole: () -> (opt Role) query;
  getMySupportConversations: () -> (vec SupportConversation);
  getOrCreateUser: () -> (Result_2);
  getPendingDeletions: (kanzleiId: KanzleiId) ->
   (vec record {
          text;
          text;
          nat;
        }) query;
  getPendingRegistration: (pendingId: PendingRegistrationId) ->
   (opt PendingRegistrationView) query;
  getRechnung: (id: text) -> (opt Rechnung) query;
  getRechnungen: (filter: RechnungFilter) -> (vec Rechnung) query;
  getRechnungsvorlage: () -> (opt Rechnungsvorlage) query;
  getRetentionPolicies: (kanzleiId: KanzleiId) -> (vec RetentionPolicy) query;
  getSuperAdmins: () -> (vec SuperAdminWhitelistEntry) query;
